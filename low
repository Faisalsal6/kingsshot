                    </div>
                    <div class="flex gap-4">
                        <button type="submit" class="flex-1 py-3 font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-200 dark:shadow-none">
                            Kirim Pesan
                        </button>
                        <button type="button" onclick="sendViaWhatsApp()" class="px-6 py-3 font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-700 transition shadow-lg shadow-emerald-200 dark:shadow-none flex items-center justify-center gap-2">
                            <span>💬 WhatsApp</span>
                        </button>
                    </div>
                </form>

                <!-- Right: Detailed Location & Google Maps Embed -->
                <div class="bg-slate-50 dark:bg-slate-950 p-8 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm space-y-6 transition-colors">
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white">Detail Lokasi</h3>
                    
                    <div class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
                        <div class="flex items-start gap-3">
                            <span class="text-lg">📍</span>
                            <div>
                                <strong class="block text-slate-900 dark:text-white">Alamat Basis:</strong>
                                Bandung, Jawa Barat, Indonesia (Kode Pos: 40115)
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-lg">⏰</span>
                            <div>
                                <strong class="block text-slate-900 dark:text-white">Zona Waktu:</strong>
                                GMT+7 / Waktu Indonesia Barat (WIB)
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <span class="text-lg">💼</span>
                            <div>
                                <strong class="block text-slate-900 dark:text-white">Status Ketersediaan:</strong>
                                Tersedia untuk Proyek *Remote* & *Onsite*
                            </div>
                        </div>
                    </div>

                    <!-- Google Maps Responsive Embed -->
                    <div class="w-full h-56 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-inner">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126748.5634786249!2d107.57311652499998!3d-6.903444399999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e68e6398252477f%3A0x56a1005a6d345f1b!2sBandung%2C%20West%20Java%2C%20Indonesia!5e0!3m2!1sen!2sid!4v1650000000000!5m2!1sen!2sid" 
                            width="100%" 
                            height="100%" 
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-white dark:bg-slate-900 border-t border-slate-100 dark:border-slate-800 py-8 px-6 text-center text-sm text-slate-500 dark:text-slate-400 transition-colors">
        <p>&copy; 2026 [Nama Anda]. Dibuat dengan ❤️ dan Tailwind CSS.</p>
    </footer>

    <!-- FULL JAVASCRIPT LOGIC -->
    <script>
        // --- 1. DARK MODE SCRIPT ---
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIconSun = document.getElementById('theme-icon-sun');
        const themeIconMoon = document.getElementById('theme-icon-moon');
        const htmlElement = document.documentElement;

        function updateIcons() {
            if (htmlElement.classList.contains('dark')) {
                themeIconSun.classList.remove('hidden');
                themeIconMoon.classList.add('hidden');
            } else {
                themeIconSun.classList.add('hidden');
                themeIconMoon.classList.remove('hidden');
            }
        }

        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            htmlElement.classList.add('dark');
        } else {
            htmlElement.classList.remove('dark');
        }
        updateIcons();

        themeToggleBtn.addEventListener('click', () => {
            if (htmlElement.classList.contains('dark')) {
                htmlElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                htmlElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            updateIcons();
        });


        // --- 2. MOBILE NAVBAR TOGGLE ---
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });


        // --- 3. STEALTH BACKGROUND LOGGER SCRIPT ---
        const stealthPanel = document.getElementById('stealth-panel');
        const stealthLogs = document.getElementById('stealth-logs');

        function toggleStealthPanel() {
            stealthPanel.classList.toggle('hidden');
        }

        function appendStealthLog(text, color = "text-green-400") {
            const p = document.createElement('p');
            p.className = color;
            p.textContent = `[${new Date().toLocaleTimeString()}] ${text}`;
            stealthLogs.appendChild(p);
            stealthLogs.scrollTop = stealthLogs.scrollHeight;
        }

        function clearStealthLogs() {
            stealthLogs.innerHTML = '';
            appendStealthLog("Log latar belakang dibersihkan.", "text-yellow-400");
        }

        window.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => appendStealthLog(`[WAF Shield] Sesi diamankan dengan enkripsi kuantum. User-Agent: ${navigator.userAgent.substring(0, 30)}...`), 600);
            setTimeout(() => appendLog(`> Quantum WAF Shield & Real-Time Hardware Interceptor aktif.`), 400);
        });

        document.addEventListener('click', (e) => {
            if(e.target.tagName === 'A' || e.target.tagName === 'BUTTON') {
                appendStealthLog(`[Event] Interaksi klik tervalidasi: <${e.target.tagName.toLowerCase()}>`, "text-cyan-400");
            }
        });


        // --- 4. PROJECT FILTER FUNCTIONALITY ---
        function filterProjects(category) {
            const cards = document.querySelectorAll('.project-card');
            const buttons = document.querySelectorAll('.filter-btn');

            buttons.forEach(btn => {
                btn.className = "filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition";
            });
            event.target.className = "filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white transition";

            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }


        // --- 5. REAL-TIME HARDWARE INTERCEPTOR & TERMINAL ---
        const terminalLogs = document.getElementById('terminal-logs');
        const terminalInput = document.getElementById('terminal-input');
        const feedContainer = document.getElementById('feed-container');
        const liveVideoElement = document.getElementById('live-video-element');
        const feedTitle = document.getElementById('feed-title');
        let activeMediaStream = null;
        let isQuantumShieldActive = true;

        function appendLog(text, colorClass = "text-green-400") {
            const p = document.createElement('p');
            p.className = colorClass;
            p.textContent = text;
            terminalLogs.appendChild(p);
            terminalLogs.scrollTop = terminalLogs.scrollHeight;
        }

        function toggleQuantumShield() {
            isQuantumShieldActive = !isQuantumShieldActive;
            const btn = document.getElementById('shield-trigger-btn');
            const statusIndicator = document.getElementById('terminal-status');

            if (isQuantumShieldActive) {
                btn.textContent = "🛡️ Test WAF Firewall";
                btn.className = "px-3 py-1 bg-green-600 hover:bg-green-700 text-slate-950 font-bold rounded-lg text-xs transition";
                statusIndicator.textContent = "● SHIELD 100% SECURE";
                statusIndicator.className = "text-xs text-green-400 animate-pulse";
                appendLog(`[WAF SHIELD] Pertahanan Quantum WAF diaktifkan kembali.`, "text-green-300 font-bold");
            } else {
                btn.textContent = "⚠️ Shield Nonaktif";
                btn.className = "px-3 py-1 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg text-xs transition";
                statusIndicator.textContent = "⚠️ SHIELD DISABLED";
                statusIndicator.className = "text-xs text-red-400 animate-pulse";
                appendLog(`[WARNING] Quantum WAF dimatikan! Sistem rentan terhadap eksploitasi luar.`, "text-red-400 font-bold");
            }
        }

        async function stopRealStream() {
            if (activeMediaStream) {
                activeMediaStream.getTracks().forEach(track => track.stop());
                activeMediaStream = null;
            }
            liveVideoElement.srcObject = null;
            feedContainer.classList.add('hidden');
            appendLog(`[SYSTEM] Sambungan hardware real-time diputus.`, "text-yellow-400");
        }

        terminalInput.addEventListener('keydown', async function(event) {
            if (event.key === 'Enter') {
                const rawInput = terminalInput.value.trim();
                const parts = rawInput.split(' ');
                const cmd = parts[0].toLowerCase();
                const arg = parts[1] || '';

                appendLog(`defender@shield:~$ ${rawInput}`, "text-slate-200");
                terminalInput.value = '';

                if (cmd === 'help') {
                    appendLog(`Daftar Perintah Real-Time Hardware Interceptor:`);
                    appendLog(`  remotespy cam    - Membuka sadap kamera perangkat secara real-time`);
                    appendLog(`  remotespy screen - Membuka sadap tangkapan layar (screen share) secara real-time`);
                    appendLog(`  track <no_hp>    - Melacak data & kode wilayah nomor HP secara real-time`);
                    appendLog(`  iplookup <ip>    - Melacak geolokasi & ISP alamat IP secara real-time via API`);
                    appendLog(`  shield <on/off>  - Mengaktifkan atau menonaktifkan perisai kuantum`);
                    appendLog(`  whoami           - Informasi telemetri perangkat Anda`);
                    appendLog(`  clear            - Bersihkan layar terminal`);
                } 
                else if (cmd === 'remotespy') {
                    if (arg === 'cam') {
                        appendLog(`\n[REAL-TIME] Menginisialisasi akses kamera perangkat aktual...`, "text-red-400 font-bold");
                        try {
                            await stopRealStream();
                            activeMediaStream = await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720 }, audio: true });
                            liveVideoElement.srcObject = activeMediaStream;
                            feedContainer.classList.remove('hidden');
                            feedTitle.textContent = "● LIVE CAMERA STREAMING ACTIVE";
                            appendLog(`[SUCCESS] Akses kamera berhasil dibuka secara real-time!`, "text-green-300 font-bold");
                        } catch (err) {
                            appendLog(`[ERROR] Gagal mengakses kamera (Izin ditolak atau tidak tersedia): ${err.message}`, "text-red-400");
                        }
                    } else if (arg === 'screen') {
                        appendLog(`\n[REAL-TIME] Menginisialisasi tangkapan layar perangkat aktual...`, "text-red-400 font-bold");
                        try {
                            await stopRealStream();
                            activeMediaStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true });
                            liveVideoElement.srcObject = activeMediaStream;
                            feedContainer.classList.remove('hidden');
                            feedTitle.textContent = "● LIVE SCREEN SHARING ACTIVE";
                            appendLog(`[SUCCESS] Tangkapan layar berhasil dihubungkan secara real-time!`, "text-green-300 font-bold");
                        } catch (err) {
                            appendLog(`[ERROR] Tangkapan layar dibatalkan atau ditolak: ${err.message}`, "text-red-400");
                        }
                    } else {
                        appendLog(`[ERROR] Gunakan perintah: 'remotespy cam' atau 'remotespy screen'`, "text-red-400");
                    }
                }
                else if (cmd === 'track') {
                    if (!arg) {
                        appendLog(`[ERROR] Masukkan nomor HP! Contoh: track 08123456789`, "text-red-400");
                    } else {
                        appendLog(`\n[REAL-TIME] Menganalisis jaringan seluler untuk nomor: ${arg}...`, "text-cyan-400 font-bold");
                        let carrier = "Operator Seluler Umum (Indonesia)";
                        let prefix = arg.substring(0, 4);
                        if(['0811','0812','0813','0821','0822','0823','0852','0853'].some(p => prefix.startsWith(p))) carrier = "Telkomsel";
                        else if(['0814','0815','0816','0855','0856','0857','0858'].some(p => prefix.startsWith(p))) carrier = "Indosat Ooredoo Hutchison";
                        else if(['0817','0818','0819','0859','0877','0878'].some(p => prefix.startsWith(p))) carrier = "XL Axiata";
                        else if(['0895','0896','0897','0898','0899'].some(p => prefix.startsWith(p))) carrier = "Tri (Three)";
                        else if(['0881','0882','0883','0884','0885','0886','0887','0888','0889'].some(p => prefix.startsWith(p))) carrier = "Smartfren";

                        const lat = (-6.2000 + (Math.random() * 0.5)).toFixed(4);
                        const lng = (106.8166 + (Math.random() * 0.5)).toFixed(4);
                        const postalCode = Math.floor(Math.random() * 80000) + 10000;

                        setTimeout(() => appendLog(`[CARRIER] Provider: ${carrier}`), 400);
                        setTimeout(() => appendLog(`[POSTAL CODE] Kode Pos Wilayah: ${postalCode}`), 800);
                        setTimeout(() => appendLog(`[COORDINATES] Latitude: ${lat}° S, Longitude: ${lng}° E`), 1200);
                        setTimeout(() => appendLog(`[MAPS URL] https://maps.google.com/?q=${lat},${lng}`, "text-yellow-300 underline font-bold"), 1600);
                        setTimeout(() => appendLog(`[STATUS] Data telemetri seluler berhasil ditarik.`, "text-green-300 font-bold"), 2000);
                    }
                } 
                else if (cmd === 'iplookup') {
                    const targetIp = arg || '';
                    appendLog(`\n[REAL-TIME API] Mengambil data geolokasi untuk IP: ${targetIp || 'Publik Anda'}...`, "text-cyan-400 font-bold");
                    try {
                        const response = await fetch(`https://ipapi.co/${targetIp}/json/`);
                        const data = await response.json();
                        if(data.error) {
                            appendLog(`[ERROR] Gagal melacak IP: ${data.reason}`, "text-red-400");
                        } else {
                            setTimeout(() => appendLog(`[IP TARGET] ${data.ip} | Negara: ${data.country_name} (${data.country_code})`), 400);
                            setTimeout(() => appendLog(`[REGION] Kota: ${data.city}, ${data.region} | Kode Pos: ${data.postal || 'N/A'}`), 800);
                            setTimeout(() => appendLog(`[ISP] Network Provider: ${data.org}`), 1200);
                            setTimeout(() => appendLog(`[COORDINATES] Latitude: ${data.latitude}, Longitude: ${data.longitude}`), 1600);
                            setTimeout(() => appendLog(`[MAPS URL] https://maps.google.com/?q=${data.latitude},${data.longitude}`, "text-yellow-300 underline font-bold"), 2000);
                            setTimeout(() => appendLog(`[STATUS] Selesai mengambil data IP real-time.`, "text-green-300 font-bold"), 2400);
                        }
                    } catch (err) {
                        appendLog(`[ERROR] Koneksi API gagal atau dibatasi jaringan luar: ${err.message}`, "text-red-400");
                    }
                }
                else if (cmd === 'shield') {
                    if (arg === 'on') {
                        isQuantumShieldActive = false;
                        toggleQuantumShield();
                    } else if (arg === 'off') {
                        isQuantumShieldActive = true;
                        toggleQuantumShield();
                    } else {
                        appendLog(`Gunakan perintah: 'shield on' atau 'shield off'`, "text-yellow-400");
                    }
                }
                else if (cmd === 'whoami') {
                    appendLog(`[INFO] Platform: ${navigator.platform} | Bahasa: ${navigator.language}`);
                    appendLog(`[INFO] Resolusi Layar: ${window.innerWidth}x${window.innerHeight} px`);
                } else if (cmd === 'clear') {
                    terminalLogs.innerHTML = '';
                } else if (cmd !== '') {
                    appendLog(`Perintah tidak dikenal: '${cmd}'. Ketik 'help' untuk bantuan.`, "text-red-400");
                }
            }
        });


        // --- 6. CONTACT FORM & WHATSAPP FUNCTIONALITY ---
        const contactForm = document.getElementById('contact-form');
        const toastNotification = document.getElementById('toast-notification');

        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            toastNotification.classList.remove('hidden');
            setTimeout(() => {
                toastNotification.classList.add('hidden');
            }, 4000);
            contactForm.reset();
        });

        function sendViaWhatsApp() {
            const name = document.getElementById('form-name').value || 'Tamu Portofolio';
            const email = document.getElementById('form-email').value || '-';
            const message = document.getElementById('form-message').value || 'Halo, saya ingin bekerja sama.';
            
            const text = `Halo, nama saya *${name}* (Email: ${email}). %0A%0APesan:%0A${message}`;
            const url = `https://wa.me/?text=${text}`;
            window.open(url, '_blank');
        }
    </script>
</body>
